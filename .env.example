# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Stripe TEST mode secret key (Stripe Dashboard -> Developers -> API keys, with Test mode on).
# Optional: leave blank and the "Stripe" payment option simply stays hidden.
# Live keys (sk_live_...) are refused on purpose.
STRIPE_SECRET_KEY=

# CAPTCHA (Cloudflare Turnstile). Optional: leave blank and the login page has no CAPTCHA.
# Set this together with Supabase -> Authentication -> Attack Protection -> CAPTCHA (see README).
# For local testing, Cloudflare's always-pass test key is 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional. Set to 1 to stop real (non-guest) businesses from using the shared test account:
# each branch must connect its own Stripe account (Settings > Online payments) before taking online payments.
STRIPE_REQUIRE_CONNECT=

# SEO: your public site address (no trailing slash). Used for sitemap, canonical links and share images.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
# Optional: paste the verification codes from Google Search Console / Bing Webmaster Tools.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
